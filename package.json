{
  "name": "servico-certo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @servico-certo/api db:migrate",
    "db:rollback": "pnpm --filter @servico-certo/api db:rollback",
    "db:seed": "pnpm --filter @servico-certo/api db:seed",
    "db:migrate:prod": "pnpm --filter @servico-certo/api db:migrate:prod",
    "db:rollback:prod": "pnpm --filter @servico-certo/api db:rollback:prod",
    "db:seed:prod": "pnpm --filter @servico-certo/api db:seed:prod"
  },
  "devDependencies": {
    "@servico-certo/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
