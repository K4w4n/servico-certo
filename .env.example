# Runtime
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=dev-only-change-me-please-32-characters-min
JWT_ISSUER=servico-certo
JWT_AUDIENCE=servico-certo-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# COOKIE_DOMAIN=.servicocerto.com

# Web / password reset
WEB_APP_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RATE_LIMIT=3
PASSWORD_RESET_RATE_WINDOW_MINUTES=15

# Mail
MAIL_TRANSPORT=console
MAIL_FROM=no-reply@servicocerto.local
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Database — SQLite for local development
DATABASE_CLIENT=better-sqlite3
SQLITE_PATH=.data/dev.sqlite

# Database — PostgreSQL (used when DATABASE_CLIENT=pg)
# DATABASE_CLIENT=pg
# DATABASE_URL=postgres://servico_certo:servico_certo@localhost:5432/servico_certo
